---
import Layout from '../../layouts/Layout.astro';
import LandedCostCalculator from '../../components/LandedCostCalculator.astro';
import importCases from '../../data/import_cases.json';
import type { ImportCase } from '../../data/types';

export const getStaticPaths = () => {
	return (importCases as ImportCase[]).map((caseData) => ({
		params: { slug: caseData.slug },
		props: { caseData },
	}));
};

interface Props {
	caseData: ImportCase;
}

const { caseData } = Astro.props;

const canonicalUrl = new URL(`/importar/${caseData.slug}/`, Astro.site).toString();

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: caseData.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.pregunta,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.respuesta,
		},
	})),
};

const softwareSchema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: `Calculadora de Landed Cost — ${caseData.producto} (HS ${caseData.hs_code})`,
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Web',
	url: canonicalUrl,
	description: `Calculadora de costo de importación (landed cost) para ${caseData.producto} desde ${caseData.origen} hacia ${caseData.destino}, código arancelario ${caseData.hs_code}. Incluye arancel ad valorem, IVA, flete internacional y gastos de destino.`,
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={caseData.seo.titulo_h1} description={caseData.seo.meta_description} canonical={canonicalUrl} ogType="website">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
	</Fragment>

	<main class="mx-auto max-w-4xl px-4 py-10">
		<nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500">
			<ol class="flex flex-wrap items-center gap-1.5">
				<li><a href="/" class="hover:text-blue-600">Inicio</a></li>
				<li aria-hidden="true">/</li>
				<li><a href="/#catalogo" class="hover:text-blue-600">Importaciones</a></li>
				<li aria-hidden="true">/</li>
				<li aria-current="page" class="font-medium text-slate-700">{caseData.producto}</li>
			</ol>
		</nav>

		<h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{caseData.seo.titulo_h1}</h1>

		<div class="mt-4 flex flex-wrap gap-2">
			<span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">HS {caseData.hs_code}</span>
			<span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700">{caseData.origen} ➔ {caseData.destino}</span>
		</div>

		<div class="mt-8">
			<LandedCostCalculator
				arancel_ad_valorem_pct={caseData.arancel_ad_valorem_pct}
				iva_pct={caseData.iva_pct}
				gastos_puerto_usd={caseData.gastos_puerto_usd}
				gastos_despacho_agente_usd={caseData.gastos_despacho_agente_usd}
				flete_estimado_m3_usd={caseData.flete_estimado_m3_usd}
				moneda={caseData.moneda}
			/>
		</div>

		<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
			<div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
				<p>
					¿Necesitas transferir dólares a proveedores en <strong>{caseData.origen}</strong>? Compara tasas de cambio B2B en{' '}
					<a href="https://wise.com" target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 hover:underline">Wise</a>
					{' / '}
					<a href="https://www.payoneer.com" target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 hover:underline">Payoneer</a>.
				</p>
			</div>
			<div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600" data-freight-quote>
				<p class="mb-3">
					¿Requieres cotización de flete marítimo real para la ruta {caseData.origen} → {caseData.destino}?
				</p>
				<form
					data-freight-form
					action="https://formspree.io/f/myegypko"
					method="POST"
					class="flex flex-col gap-2"
				>
					<input type="hidden" name="producto" value={caseData.producto} />
					<input type="hidden" name="ruta" value={`${caseData.origen} → ${caseData.destino}`} />
					<input type="hidden" name="hs_code" value={caseData.hs_code} />
					<input type="hidden" name="lead_id" data-freight-lead-id value="" />
					<label for="freight-nombre" class="sr-only">Nombre completo</label>
					<input
						type="text"
						id="freight-nombre"
						name="nombre"
						placeholder="Nombre completo"
						required
						class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
					/>
					<label for="freight-email" class="sr-only">Correo electrónico</label>
					<input
						type="email"
						id="freight-email"
						name="email"
						placeholder="Correo electrónico"
						required
						class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
					/>
					<label for="freight-telefono" class="sr-only">Teléfono</label>
					<input
						type="tel"
						id="freight-telefono"
						name="telefono"
						placeholder="Teléfono (opcional)"
						class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
					/>
					<label for="freight-empresa" class="sr-only">Empresa</label>
					<input
						type="text"
						id="freight-empresa"
						name="empresa"
						placeholder="Empresa (opcional)"
						class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
					/>
					<label for="freight-volumen" class="sr-only">Volumen aproximado de carga</label>
					<select
						id="freight-volumen"
						name="volumen_carga"
						class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
					>
						<option value="">Volumen aproximado de carga (opcional)</option>
						<option value="Menos de 5 m³ (carga suelta / LCL)">Menos de 5 m³ (carga suelta / LCL)</option>
						<option value="5–15 m³ (LCL)">5–15 m³ (LCL)</option>
						<option value="1 contenedor completo (FCL)">1 contenedor completo (FCL)</option>
						<option value="Más de 1 contenedor (FCL)">Más de 1 contenedor (FCL)</option>
					</select>
					<label for="freight-fecha" class="block text-xs text-slate-500">Fecha aproximada de envío (opcional)</label>
					<input
						type="date"
						id="freight-fecha"
						name="fecha_envio"
						class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
					/>
					<button
						type="submit"
						data-freight-submit
						class="mt-1 rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-60"
					>
						Solicitar 3 presupuestos de agencias de carga
					</button>
					<div class="hidden flex-col items-start gap-1" data-freight-success-wrap>
						<p class="text-xs font-medium text-emerald-600" data-freight-success role="status"></p>
						<a
							href="#"
							download
							class="text-xs font-semibold text-blue-600 underline hover:text-blue-700"
							data-freight-download
						>
							Descargar resumen de tu cálculo (CSV)
						</a>
					</div>
					<p class="hidden text-xs font-medium text-red-600" data-freight-error role="alert">
						Ocurrió un error al enviar tu solicitud. Intenta nuevamente.
					</p>
				</form>
			</div>
		</div>

		<script>
			const freightForm = document.querySelector<HTMLFormElement>('[data-freight-form]');
			const freightSubmit = freightForm?.querySelector<HTMLButtonElement>('[data-freight-submit]');
			const freightSuccessWrap = freightForm?.querySelector<HTMLElement>('[data-freight-success-wrap]');
			const freightSuccess = freightForm?.querySelector<HTMLElement>('[data-freight-success]');
			const freightDownload = freightForm?.querySelector<HTMLAnchorElement>('[data-freight-download]');
			const freightError = freightForm?.querySelector<HTMLElement>('[data-freight-error]');
			const freightLeadId = freightForm?.querySelector<HTMLInputElement>('[data-freight-lead-id]');

			function csvEscape(value: string): string {
				if (/[",\n]/.test(value)) return `"${value.replace(/"/g, '""')}"`;
				return value;
			}

			function buildCalculationSummaryCsv(leadId: string): string {
				const calculator = document.querySelector<HTMLElement>('[data-landed-cost-calculator]');
				const getOutput = (field: string) => calculator?.querySelector<HTMLElement>(`[data-output="${field}"]`)?.textContent?.trim() ?? '';
				const getInput = (field: string) => calculator?.querySelector<HTMLInputElement>(`[data-field="${field}"]`)?.value ?? '';
				const getFormValue = (name: string) => (freightForm?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';

				const rows: [string, string][] = [
					['Referencia', leadId],
					['Fecha de solicitud', new Date().toLocaleDateString('es-CL')],
					['Producto', getFormValue('producto')],
					['Código HS', getFormValue('hs_code')],
					['Ruta', getFormValue('ruta')],
					['Cantidad de unidades', getInput('units')],
					['Precio FOB unitario (USD)', getInput('fob-price')],
					['Volumen total (m³)', getInput('volume')],
					['Seguro marítimo (%)', getInput('insurance-pct')],
					['Total FOB productos', getOutput('desglose-fob')],
					['Flete internacional estimado', getOutput('desglose-flete')],
					['Seguro CIF', getOutput('desglose-seguro')],
					['Impuesto Ad Valorem', getOutput('desglose-ad-valorem')],
					['IVA importación', getOutput('desglose-iva')],
					['Gastos destino (puerto + agente)', getOutput('desglose-gastos-destino')],
					['Costo total de la importación', getOutput('landed-cost-total')],
					['Costo unitario puesto en bodega', getOutput('landed-cost-unitario')],
					['Precio de venta mínimo sugerido', getOutput('precio-venta-sugerido')],
					['Nombre', getFormValue('nombre')],
					['Empresa', getFormValue('empresa')],
					['Email', getFormValue('email')],
					['Teléfono', getFormValue('telefono')],
					['Volumen de carga', getFormValue('volumen_carga')],
					['Fecha aproximada de envío', getFormValue('fecha_envio')],
				];

				const bom = String.fromCharCode(0xfeff);
				const header = 'Campo,Valor';
				const body = rows.map(([label, value]) => `${csvEscape(label)},${csvEscape(value)}`).join('\n');
				return `${bom}${header}\n${body}\n`;
			}

			function generateLeadId(): string {
				const now = new Date();
				const y = now.getFullYear();
				const m = String(now.getMonth() + 1).padStart(2, '0');
				const d = String(now.getDate()).padStart(2, '0');
				const rand = Math.random().toString(36).slice(2, 6).toUpperCase();
				return `LEAD-${y}${m}${d}-${rand}`;
			}

			if (freightLeadId) freightLeadId.value = generateLeadId();

			freightForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!freightSubmit) return;

				freightSuccessWrap?.classList.add('hidden');
				freightSuccessWrap?.classList.remove('flex');
				freightError?.classList.add('hidden');
				freightSubmit.disabled = true;
				const originalLabel = freightSubmit.textContent;
				freightSubmit.textContent = 'Enviando…';

				const submittedLeadId = freightLeadId?.value ?? '';
				const csvContent = buildCalculationSummaryCsv(submittedLeadId);

				try {
					const response = await fetch(freightForm.action, {
						method: 'POST',
						headers: { Accept: 'application/json' },
						body: new FormData(freightForm),
					});

					if (response.ok) {
						freightForm.reset();
						if (freightLeadId) freightLeadId.value = generateLeadId();
						if (freightSuccess) {
							freightSuccess.textContent = `¡Listo! Recibimos tu solicitud (ref. ${submittedLeadId}), te contactaremos pronto con las cotizaciones.`;
						}
						if (freightDownload) {
							const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
							freightDownload.href = URL.createObjectURL(blob);
							freightDownload.download = `landed-cost-${submittedLeadId}.csv`;
						}
						freightSuccessWrap?.classList.remove('hidden');
						freightSuccessWrap?.classList.add('flex');
					} else {
						freightError?.classList.remove('hidden');
					}
				} catch {
					freightError?.classList.remove('hidden');
				} finally {
					freightSubmit.disabled = false;
					freightSubmit.textContent = originalLabel;
				}
			});
		</script>

		<section aria-labelledby="regulaciones-heading" class="mt-12 rounded-xl border border-amber-200 bg-amber-50 p-6">
			<h2 id="regulaciones-heading" class="text-2xl font-bold text-slate-900">Regulaciones y Requisitos de Aduana</h2>
			<p class="mt-3 text-slate-700">
				Para importar <strong>{caseData.producto}</strong> hacia <strong>{caseData.destino}</strong>, debes cumplir con el siguiente
				requisito antes de que la mercancía pueda ser liberada por la aduana:
			</p>
			<p class="mt-3 rounded-lg bg-white p-4 font-medium text-amber-800 ring-1 ring-amber-200">
				{caseData.permisos_especiales}
			</p>
			<p class="mt-3 text-sm text-slate-600">
				Te recomendamos coordinar este trámite con tu agente de aduana con anticipación para evitar demoras o costos de
				almacenaje adicionales en puerto.
			</p>
		</section>

		<section aria-labelledby="faq-heading" class="mt-12">
			<h2 id="faq-heading" class="text-2xl font-bold text-slate-900">Preguntas Frecuentes</h2>
			<div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
				{caseData.faqs.map((faq) => (
					<details class="group p-5 [&::-webkit-details-marker]:hidden">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-slate-900">
							{faq.pregunta}
							<span class="shrink-0 text-lg text-slate-400 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
						</summary>
						<p class="mt-3 text-sm leading-relaxed text-slate-600">{faq.respuesta}</p>
					</details>
				))}
			</div>
		</section>
	</main>
</Layout>
