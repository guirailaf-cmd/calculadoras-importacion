---
import Layout from '../layouts/Layout.astro';
import importCasesRaw from '../data/import_cases.json';
import type { ImportCase } from '../data/types';

const importCases = importCasesRaw as ImportCase[];
const canonicalUrl = new URL('/', Astro.site).toString();
---

<Layout
	title="Calculadoras de Costo de Importación B2B — Chile y LATAM"
	description="Calcula el landed cost real de más de 20 productos importados desde China, Estados Unidos e India hacia Chile y LATAM: aranceles, IVA, fletes, gastos de destino y permisos especiales."
	canonical={canonicalUrl}
>
	<main class="mx-auto max-w-6xl px-4 py-12">
		<header class="mx-auto mb-10 max-w-2xl text-center">
			<h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Calculadoras de Costo de Importación B2B</h1>
			<p class="mt-3 text-slate-600">
				Calcula el landed cost real de tu importación desde China, Estados Unidos e India hacia Chile y LATAM: aranceles,
				IVA, fletes, gastos de destino y permisos especiales.
			</p>
		</header>

		<div class="mx-auto mb-8 max-w-xl">
			<label for="search" class="sr-only">Buscar producto, origen o destino</label>
			<input
				type="search"
				id="search"
				placeholder="Buscar por producto, origen o destino…"
				class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
				data-search-input
			/>
		</div>

		<section id="catalogo" aria-label="Catálogo de casos de importación" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{importCases.map((c) => (
				<a
					href={`/importar/${c.slug}/`}
					class="group flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow-md"
					data-card
					data-search={`${c.producto} ${c.origen} ${c.destino} ${c.seo.keywords.join(' ')}`.toLowerCase()}
				>
					<div class="mb-3 flex flex-wrap gap-2">
						<span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">HS {c.hs_code}</span>
						<span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700">{c.origen} ➔ {c.destino}</span>
					</div>
					<h2 class="text-base font-semibold text-slate-900 group-hover:text-blue-600">{c.producto}</h2>
					<p class="mt-2 line-clamp-2 text-sm text-slate-500">{c.seo.meta_description}</p>
				</a>
			))}
		</section>

		<p class="mt-6 hidden text-center text-sm text-slate-500" data-empty-state>
			No se encontraron productos que coincidan con tu búsqueda.
		</p>
	</main>
</Layout>

<script>
	const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
	const cards = document.querySelectorAll<HTMLAnchorElement>('[data-card]');
	const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

	searchInput?.addEventListener('input', () => {
		const query = searchInput.value.trim().toLowerCase();
		let visibleCount = 0;

		cards.forEach((card) => {
			const matches = card.dataset.search?.includes(query) ?? true;
			card.classList.toggle('hidden', !matches);
			if (matches) visibleCount += 1;
		});

		emptyState?.classList.toggle('hidden', visibleCount > 0);
	});
</script>
